<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ядро: звуковой движок, библиотека звуков, конфиг, горячие клавиши, сервер управления -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Xoard.Core</RootNamespace>
    <AssemblyName>Xoard.Core</AssemblyName>
    <!-- LibraryImport (P/Invoke через генератор) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" />
  </ItemGroup>

  <!-- Шумоподавление голоса: RNNoise 0.2 (BSD-3), собран Native\build-rnnoise.cmd; кладётся рядом с программой -->
  <ItemGroup>
    <None Include="Native\rnnoise.dll" Link="rnnoise.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\RNNoise-COPYING.txt" Link="RNNoise-COPYING.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xoard.Protocol\Xoard.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Xoard.Core.Tests" />
    <!-- Консольный стенд проверки движка -->
    <InternalsVisibleTo Include="Xoard.Poc" />
  </ItemGroup>

</Project>
