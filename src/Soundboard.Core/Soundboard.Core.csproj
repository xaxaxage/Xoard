<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ядро: звуковой движок, библиотека звуков, конфиг, горячие клавиши, сервер управления -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Soundboard.Core</RootNamespace>
    <AssemblyName>Soundboard.Core</AssemblyName>
    <!-- LibraryImport (P/Invoke через генератор) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Soundboard.Core.Tests" />
    <!-- Консольный стенд проверки движка -->
    <InternalsVisibleTo Include="Soundboard.Poc" />
  </ItemGroup>

</Project>
