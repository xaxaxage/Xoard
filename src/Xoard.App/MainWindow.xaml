<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Xoard.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Xoard.App.ViewModels"
    Title="Xoard">

    <Grid x:Name="Root" RowDefinitions="Auto,*,Auto" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

        <!-- ═══ Панель сверху: название, поиск, режим, статус, «Стоп всё» ═══ -->
        <Grid Padding="16,10,16,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="Assets/Logo.png" Width="28" Height="28" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="Xoard" Style="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>

            <TextBox Grid.Column="1" x:Name="SearchBox" AutomationProperties.Name="Поиск звуков" PlaceholderText="Поиск звуков" Width="280" HorizontalAlignment="Left"
                     VerticalAlignment="Center" Text="{x:Bind Vm.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{x:Bind Vm.ToggleModeCommand}" AutomationProperties.Name="Режим повтора" ToolTipService.ToolTip="Что делать при повторном нажатии: наложить звук поверх или начать заново">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="{x:Bind Vm.ModeGlyph, Mode=OneWay}" FontSize="14" />
                        <TextBlock Text="{x:Bind Vm.ModeText, Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <Button x:Name="StatusButton" AutomationProperties.Name="Состояние звука" ToolTipService.ToolTip="Состояние звука и VB-CABLE">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="StatusIcon" Glyph="{x:Bind Vm.StatusGlyph, Mode=OneWay}" FontSize="14" />
                        <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="380" Spacing="8">
                                <TextBlock Text="{x:Bind Vm.VbCableText, Mode=OneWay}" TextWrapping="Wrap" />
                                <HyperlinkButton Content="Скачать VB-CABLE" Command="{x:Bind Vm.OpenVbCableSiteCommand}"
                                                 Visibility="{x:Bind Vm.VbCableMissing, Mode=OneWay}" Padding="0" />
                                <HyperlinkButton Content="Как настроить Discord" Command="{x:Bind Vm.ShowSetupGuideCommand}" Padding="0" />
                                <ItemsControl ItemsSource="{x:Bind Vm.Issues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:IssueView">
                                            <InfoBar IsOpen="True" IsClosable="False" Margin="0,4,0,0"
                                                     Title="{x:Bind Title}" Message="{x:Bind Message}" Severity="{x:Bind Severity}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button Command="{x:Bind Vm.StopAllCommand}" AutomationProperties.Name="Стоп всё" Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Остановить все звуки">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                        <TextBlock Text="Стоп всё" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ Середина: навигация, сетка звуков / настройки ═══ -->
        <NavigationView Grid.Row="1" x:Name="Nav" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False" IsSettingsVisible="True" SelectionChanged="OnNavigationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="SoundsNavItem" Content="Звуки" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF0E2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="RecordNavItem" Content="Запись">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE720;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <!-- Звуки -->
                <Grid x:Name="SoundsPanel" RowDefinitions="Auto,Auto,*" Padding="16,8,16,8">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Text="{x:Bind Vm.SoundsCountText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Click="OnAddSoundsClick" AutomationProperties.Name="Добавить звуки" ToolTipService.ToolTip="Добавить mp3, wav, flac… (или перетащите файлы в окно)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Добавить звуки" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <!-- Нет VB-CABLE: без него звуки не дойдут до друзей — показываем сразу, на главном экране -->
                        <InfoBar IsOpen="{x:Bind Vm.VbCableMissing, Mode=OneWay}" IsClosable="False" Severity="Error" Margin="0,0,0,8"
                                 Title="VB-CABLE не установлен"
                                 Message="Без него друзья не услышат звуки. Скачайте бесплатный драйвер, запустите установщик от имени администратора и перезагрузите компьютер — Xoard найдёт кабель сам.">
                            <InfoBar.ActionButton>
                                <Button Content="Скачать VB-CABLE" Command="{x:Bind Vm.OpenVbCableSiteCommand}" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <InfoBar IsOpen="{x:Bind Vm.ToastOpen, Mode=TwoWay}" Message="{x:Bind Vm.ToastMessage, Mode=OneWay}"
                                 Severity="{x:Bind Vm.ToastSeverity, Mode=OneWay}" Margin="0,0,0,8" />
                    </StackPanel>

                    <GridView Grid.Row="2" x:Name="SoundsGrid" ItemsSource="{x:Bind Vm.VisibleSounds}"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnSoundClick"
                              CanDragItems="{x:Bind Vm.IsSearchEmpty, Mode=OneWay}" CanReorderItems="{x:Bind Vm.IsSearchEmpty, Mode=OneWay}"
                              AllowDrop="True" DragItemsCompleted="OnDragItemsCompleted"
                              DragOver="OnDragOver" Drop="OnDrop" Padding="0,0,0,8">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SoundItem">
                                <Grid Width="{StaticResource TileWidth}" Height="{StaticResource TileHeight}" CornerRadius="{StaticResource TileCornerRadius}"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Играть" Command="{x:Bind PlayCommand}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Только мне (предпрослушать)" Command="{x:Bind PreviewCommand}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7F6;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Назначить клавишу…" Command="{x:Bind AssignHotkeyCommand}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE765;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Обрезать…" Command="{x:Bind TrimCommand}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A8;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Переименовать…" Command="{x:Bind RenameCommand}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Показать в папке" Command="{x:Bind ShowInFolderCommand}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Удалить в корзину" Command="{x:Bind DeleteCommand}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>

                                    <!-- Подсветка играющего звука -->
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.18"
                                            Visibility="{x:Bind IsPlaying, Mode=OneWay}" />

                                    <Grid Padding="12,10" RowDefinitions="*,Auto">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextWrapping="Wrap" MaxLines="2"
                                                   TextTrimming="CharacterEllipsis" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                            <TextBlock Text="{x:Bind DurationText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <!-- Горячая клавиша: справа, длинное сочетание сокращается многоточием -->
                                            <Border Grid.Column="1" Padding="5,1" CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="{x:Bind HasHotkey, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind HotkeyText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <ProgressRing Grid.Column="2" Width="14" Height="14" IsActive="{x:Bind IsLoading, Mode=OneWay}" />
                                            <FontIcon Grid.Column="2" Glyph="&#xE7BA;" FontSize="14" Visibility="{x:Bind HasError, Mode=OneWay}"
                                                      Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        </Grid>
                                    </Grid>

                                    <ProgressBar VerticalAlignment="Bottom" Maximum="1" Value="{x:Bind Progress, Mode=OneWay}"
                                                 Visibility="{x:Bind IsPlaying, Mode=OneWay}" Margin="8,0,8,4" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- Пусто -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                                Visibility="{x:Bind Vm.HasNoSounds, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8D6;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Добавьте первые звуки" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Перетащите mp3 или wav в окно — или нажмите кнопку." HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="Добавить звуки" Click="OnAddSoundsClick" HorizontalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="Ничего не найдено" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind Vm.HasNoMatches, Mode=OneWay}" />
                </Grid>

                <!-- Запись -->
                <ScrollViewer x:Name="RecordingPanel" Visibility="Collapsed" Padding="24,12,24,24">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="12">
                        <TextBlock Text="Запись" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />
                        <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <RadioButtons Header="Что записывать" SelectedIndex="{x:Bind Vm.RecordSourceIndex, Mode=TwoWay}" MaxColumns="2">
                                    <x:String>Звук компьютера</x:String>
                                    <x:String>Микрофон</x:String>
                                </RadioButtons>
                                <TextBlock Text="{x:Bind Vm.RecordSourceHint, Mode=OneWay}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <Button Command="{x:Bind Vm.ToggleRecordingCommand}" Style="{StaticResource AccentButtonStyle}" Padding="16,8"
                                            AutomationProperties.Name="Начать или остановить запись">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="{x:Bind Vm.RecordButtonGlyph, Mode=OneWay}" FontSize="16" />
                                            <TextBlock Text="{x:Bind Vm.RecordButtonText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{x:Bind Vm.RecordingTimeText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <ProgressBar Maximum="1" Value="{x:Bind Vm.RecordingMeter, Mode=OneWay}" />
                                <TextBlock Text="После остановки откроется обрезка — выделите мышкой нужный кусок." TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Повтор" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                        <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <ToggleSwitch Header="Постоянно хранить последние секунды звука компьютера" IsOn="{x:Bind Vm.ReplayEnabled, Mode=TwoWay}"
                                              OnContent="Включено" OffContent="Выключено" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <TextBlock Text="Длина буфера" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="10" Maximum="120" StepFrequency="5" Value="{x:Bind Vm.ReplaySeconds, Mode=TwoWay}"
                                            AutomationProperties.Name="Длина буфера повтора" />
                                </Grid>
                                <TextBlock Text="{x:Bind Vm.ReplayStatusText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Button Command="{x:Bind Vm.SaveReplayCommand}" AutomationProperties.Name="Сохранить повтор">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Vm.ReplaySaveText, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Клавиши для записи и повтора — в Настройках → «Горячие клавиши». Работают и в полноэкранных играх."
                                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Настройки -->
                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" Padding="24,12,24,24">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="12">
                        <TextBlock Text="Настройки" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />

                        <TextBlock Text="Устройства" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                            <TextBlock Text="Наушники (только звуки)" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Vm.HeadphoneOptions}"
                                      SelectedIndex="{x:Bind Vm.HeadphonesIndex, Mode=TwoWay}" DisplayMemberPath="Label" />
                            <TextBlock Grid.Row="1" Text="Микрофон" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Vm.MicOptions}"
                                      SelectedIndex="{x:Bind Vm.MicIndex, Mode=TwoWay}" DisplayMemberPath="Label" />
                            <TextBlock Grid.Row="2" Text="Передавать мой голос" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Row="2" Grid.Column="1" IsOn="{x:Bind Vm.PassthroughEnabled, Mode=TwoWay}"
                                          OnContent="Да — друзья слышат меня и звуки" OffContent="Нет — только звуки" />
                        </Grid>

                        <Border Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Виртуальный микрофон (VB-CABLE)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Vm.VbCableText, Mode=OneWay}" TextWrapping="Wrap" />
                                <HyperlinkButton Content="Скачать VB-CABLE (бесплатно)" Command="{x:Bind Vm.OpenVbCableSiteCommand}"
                                                 Visibility="{x:Bind Vm.VbCableMissing, Mode=OneWay}" Padding="0" />
                                <Button Content="Как настроить Discord" Command="{x:Bind Vm.ShowSetupGuideCommand}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{x:Bind Vm.Issues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:IssueView">
                                    <InfoBar IsOpen="True" IsClosable="False" Margin="0,0,0,8"
                                             Title="{x:Bind Title}" Message="{x:Bind Message}" Severity="{x:Bind Severity}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Воспроизведение" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                            <TextBlock Text="Повторное нажатие" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" SelectedIndex="{x:Bind Vm.ModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <x:String>Наложить поверх играющего</x:String>
                                <x:String>Перезапустить звук</x:String>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Text="Задержка" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="{x:Bind Vm.LatencyIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <x:String>Обычная (рекомендуется)</x:String>
                                <x:String>Надёжная — если звук хрипит на слабом ПК</x:String>
                                <x:String>Низкая — экспериментально</x:String>
                            </ComboBox>
                            <TextBlock Grid.Row="2" Text="Канал микрофона" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="{x:Bind Vm.MicChannelIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <x:String>Среднее левого и правого</x:String>
                                <x:String>Только левый</x:String>
                                <x:String>Только правый</x:String>
                            </ComboBox>
                        </Grid>

                        <TextBlock Text="Горячие клавиши" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                        <Grid ColumnDefinitions="200,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="8">
                            <TextBlock Grid.Row="1" Text="Начать/остановить запись" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Vm.RecordHotkeyText, Mode=OneWay}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Назначить…" Command="{x:Bind Vm.AssignRecordHotkeyCommand}"
                                    AutomationProperties.Name="Назначить клавишу записи" />
                            <TextBlock Grid.Row="2" Text="Сохранить повтор" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind Vm.ReplayHotkeyText, Mode=OneWay}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Grid.Row="2" Grid.Column="2" Content="Назначить…" Command="{x:Bind Vm.AssignReplayHotkeyCommand}"
                                    AutomationProperties.Name="Назначить клавишу повтора" />
                            <TextBlock Text="Клавиша «Стоп всё»" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Vm.StopAllHotkeyText, Mode=OneWay}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Grid.Column="2" Content="Назначить…" Command="{x:Bind Vm.AssignStopHotkeyCommand}"
                                    AutomationProperties.Name="Назначить клавишу «Стоп всё»" />
                        </Grid>
                        <TextBlock Text="Клавиши звуков назначаются правой кнопкой по плитке. Работают в любой программе и в полноэкранных играх."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="Запуск и трей" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="8">
                            <TextBlock Text="Запускать вместе с Windows" VerticalAlignment="Top" Margin="0,6,0,0" />
                            <StackPanel Grid.Column="1">
                                <ToggleSwitch IsOn="{x:Bind Vm.AutostartEnabled, Mode=TwoWay}"
                                              OnContent="Да — свёрнутым в трей" OffContent="Нет" AutomationProperties.Name="Запускать вместе с Windows" />
                                <TextBlock Text="{x:Bind Vm.AutostartHint, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind Vm.HasAutostartHint, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Кнопка ✕ в окне" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Row="1" Grid.Column="1" IsOn="{x:Bind Vm.CloseToTray, Mode=TwoWay}" AutomationProperties.Name="Сворачивать в трей"
                                          OnContent="Прячет в трей — звуки и клавиши работают" OffContent="Закрывает программу" />
                        </Grid>

                        <TextBlock Text="Звуки и интерфейс" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                        <Grid ColumnDefinitions="200,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="8">
                            <TextBlock Text="Папка звуков" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Vm.SoundsFolder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Grid.Column="2" Content="Открыть" Command="{x:Bind Vm.OpenSoundsFolderCommand}" />
                            <TextBlock Grid.Row="1" Text="Анимации" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Row="1" Grid.Column="1" IsOn="{x:Bind Vm.AnimationsEnabled, Mode=TwoWay}"
                                          OnContent="Включены" OffContent="Выключены" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <!-- ═══ Микшер снизу ═══ -->
        <Grid Grid.Row="2" Padding="16,10,16,12" ColumnDefinitions="*,*,*" ColumnSpacing="24"
              Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="2">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <FontIcon Glyph="&#xE7F6;" FontSize="14" />
                    <TextBlock Grid.Column="1" Text="Мне в наушники" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Vm.HeadphonesText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <Slider AutomationProperties.Name="Громкость в наушниках" Minimum="0" Maximum="100" StepFrequency="1" Value="{x:Bind Vm.HeadphonesLevel, Mode=TwoWay}" IsThumbToolTipEnabled="False" />
                <ProgressBar Maximum="1" Value="{x:Bind Vm.HeadphonesMeter, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <FontIcon Glyph="&#xE789;" FontSize="14" />
                    <TextBlock Grid.Column="1" Text="Звуки друзьям" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Vm.CableText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <Slider AutomationProperties.Name="Громкость звуков для друзей" Minimum="0" Maximum="100" StepFrequency="1" Value="{x:Bind Vm.CableLevel, Mode=TwoWay}" IsThumbToolTipEnabled="False" />
                <ProgressBar Maximum="1" Value="{x:Bind Vm.CableMeter, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="2">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <FontIcon Glyph="&#xE720;" FontSize="14" />
                    <TextBlock Grid.Column="1" Text="Мой голос" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Vm.MicText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ToggleButton Grid.Column="3" IsChecked="{x:Bind Vm.MicMuted, Mode=TwoWay}" AutomationProperties.Name="Выключить голос" Padding="6,2"
                                  ToolTipService.ToolTip="Выключить голос (друзья слышат только звуки)">
                        <FontIcon Glyph="&#xF781;" FontSize="12" />
                    </ToggleButton>
                </Grid>
                <Slider AutomationProperties.Name="Громкость голоса" Minimum="0" Maximum="100" StepFrequency="1" Value="{x:Bind Vm.MicLevel, Mode=TwoWay}" IsThumbToolTipEnabled="False" />
                <ProgressBar Maximum="1" Value="{x:Bind Vm.MicMeter, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- ═══ Подсказка: VB-CABLE и Discord (проверки обновляются, пока окно открыто) ═══ -->
        <ContentDialog x:Name="SetupGuide" Title="Как настроить Discord" CloseButtonText="Готово" DefaultButton="Close"
                       Opened="OnSetupGuideOpened" Closed="OnSetupGuideClosed">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
            </ContentDialog.Resources>
            <ScrollViewer>
                <StackPanel Spacing="8" Padding="0,0,12,0">
                    <InfoBar IsOpen="True" IsClosable="False" Message="{x:Bind Vm.CableCheck.Text, Mode=OneWay}" Severity="{x:Bind Vm.CableCheck.Severity, Mode=OneWay}" />
                    <HyperlinkButton Content="Скачать VB-CABLE (бесплатно)" Command="{x:Bind Vm.OpenVbCableSiteCommand}"
                                     Visibility="{x:Bind Vm.VbCableMissing, Mode=OneWay}" Padding="0" Margin="0,-4,0,0" />
                    <InfoBar IsOpen="True" IsClosable="False" Message="{x:Bind Vm.DiscordCheck.Text, Mode=OneWay}" Severity="{x:Bind Vm.DiscordCheck.Severity, Mode=OneWay}" />
                    <InfoBar IsOpen="True" IsClosable="False" Message="{x:Bind Vm.OutputCheck.Text, Mode=OneWay}" Severity="{x:Bind Vm.OutputCheck.Severity, Mode=OneWay}" />

                    <TextBlock Text="В Discord: Настройки пользователя → «Голос и видео»" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                    <TextBlock TextWrapping="Wrap" LineHeight="22">
                        <Run Text="1. Устройство ввода — «CABLE Output (VB-Audio Virtual Cable)»." /><LineBreak />
                        <Run Text="2. Устройство вывода — ваши наушники или колонки (не «CABLE Input»)." /><LineBreak />
                        <Run Text="3. Режим ввода — «Активация по голосу». Выключите «Автоматически определять чувствительность» и сдвиньте ползунок почти до упора влево — иначе тихие звуки обрезаются." /><LineBreak />
                        <Run Text="4. «Обработка голоса»: выключите шумоподавление (Krisp), эхоподавление и автоматическую регулировку усиления — они глушат музыку и звуки." /><LineBreak />
                        <Run Text="5. Нажмите «Проверка микрофона» и запустите любой звук — полоска уровня должна двигаться." />
                    </TextBlock>

                    <TextBlock Text="Ваш голос" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Микрофон выбирается здесь, в Настройках Xoard: голос и звуки вместе уходят в кабель. В Discord микрофон не выбирайте — только CABLE Output." />

                    <TextBlock Text="В играх" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Если в игре есть голосовой чат, выберите в её настройках звука микрофон «CABLE Output»." />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Window>
