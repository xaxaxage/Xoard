<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Xoard.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Xoard">

    <Grid x:Name="Root" Background="{StaticResource XBg}" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" KeyDown="OnRootKeyDown">
        <Grid RowDefinitions="Auto,Auto,*">
            <!-- Вышла новая версия: скачивается и ставится только по кнопке -->
            <Grid Grid.Row="1" Padding="24,12,24,0" Visibility="{x:Bind Vm.UpdateBannerOpen, Mode=OneWay}">
                <InfoBar IsOpen="{x:Bind Vm.UpdateBannerOpen, Mode=TwoWay}" IsClosable="{x:Bind Vm.UpdateIdle, Mode=OneWay}" Severity="Informational"
                         Title="{x:Bind Vm.UpdateBannerTitle, Mode=OneWay}" ToolTipService.ToolTip="Крестик — напомнить позже"
                         Message="Скачается и поставится, программа перезапустится. Звуки, клавиши и настройки останутся.">
                    <InfoBar.ActionButton>
                        <Button Style="{StaticResource XPrimaryButton}" MinHeight="32" FontSize="14" Command="{x:Bind Vm.InstallUpdateCommand}"
                                IsEnabled="{x:Bind Vm.UpdateIdle, Mode=OneWay}" Content="Обновить" HorizontalAlignment="Left"
                                CornerRadius="{Binding Control, Source={StaticResource Shape}}" />
                    </InfoBar.ActionButton>
                    <InfoBar.Content>
                        <ProgressBar Maximum="100" Value="{x:Bind Vm.UpdateProgress, Mode=OneWay}" Margin="0,0,0,12" Visibility="{x:Bind Vm.UpdateBusy, Mode=OneWay}" />
                    </InfoBar.Content>
                </InfoBar>
            </Grid>

            <!-- Нет VB-CABLE: без него звуки не дойдут до друзей — сразу видно на главном экране -->
            <Grid Padding="24,12,24,0" Visibility="{x:Bind Vm.VbCableMissing, Mode=OneWay}">
                <InfoBar IsOpen="True" IsClosable="False" Severity="Error" Title="VB-CABLE не установлен"
                         Message="Без него друзья не услышат звуки. Скачайте бесплатный драйвер, запустите установщик от имени администратора и перезагрузите компьютер — Xoard найдёт кабель сам.">
                    <InfoBar.ActionButton>
                        <Button Content="Скачать VB-CABLE" Command="{x:Bind Vm.OpenVbCableSiteCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </Grid>

            <!-- Раскладка (Пульт; позже — Док и Лента) -->
            <ContentControl Grid.Row="2" x:Name="BoardHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />
        </Grid>

        <!-- Уведомление: тёмная пилюля внизу -->
        <Border x:Name="ToastPill" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,24" Padding="16,10" MaxWidth="560"
                Background="{StaticResource XInk}" CornerRadius="{Binding Control, Source={StaticResource Shape}}"
                Visibility="{x:Bind Vm.ToastOpen, Mode=OneWay}" Tapped="OnToastTapped">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind Vm.ToastDot, Mode=OneWay}" />
                <TextBlock Text="{x:Bind Vm.ToastMessage, Mode=OneWay}" Foreground="{StaticResource XBg}" FontFamily="{StaticResource XFontText}"
                           FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="500" />
            </StackPanel>
        </Border>

        <!-- Настройки: затемнение и окно по центру (разделы слева) -->
        <Grid x:Name="SettingsLayer" Visibility="Collapsed">
            <Rectangle Fill="{StaticResource XScrim}" Tapped="OnScrimTapped" />
            <ContentControl x:Name="SheetHost" MaxWidth="920" MaxHeight="680" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />
        </Grid>

        <!-- Редактор клипа: новая запись или повтор (ещё не файл), обрезка звука -->
        <Grid x:Name="EditorLayer" Visibility="Collapsed">
            <Rectangle Fill="{StaticResource XScrim}" />
            <ContentControl x:Name="EditorHost" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Stretch" IsTabStop="False" />
        </Grid>

        <!-- ═══ Подсказка: VB-CABLE и Discord (проверки обновляются, пока окно открыто) ═══ -->
        <ContentDialog x:Name="SetupGuide" Title="Как настроить Discord" CloseButtonText="Готово" DefaultButton="Close"
                       Opened="OnSetupGuideOpened" Closed="OnSetupGuideClosed">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
            </ContentDialog.Resources>
            <ScrollViewer>
                <StackPanel Spacing="8" Padding="0,0,12,0">
                    <InfoBar IsOpen="True" IsClosable="False" Message="{x:Bind Vm.CableCheck.Text, Mode=OneWay}" Severity="{x:Bind Vm.CableCheck.Severity, Mode=OneWay}" />
                    <HyperlinkButton Content="Скачать VB-CABLE (бесплатно)" Command="{x:Bind Vm.OpenVbCableSiteCommand}"
                                     Visibility="{x:Bind Vm.VbCableMissing, Mode=OneWay}" Padding="0" Margin="0,-4,0,0" />
                    <InfoBar IsOpen="True" IsClosable="False" Message="{x:Bind Vm.DiscordCheck.Text, Mode=OneWay}" Severity="{x:Bind Vm.DiscordCheck.Severity, Mode=OneWay}" />
                    <InfoBar IsOpen="True" IsClosable="False" Message="{x:Bind Vm.OutputCheck.Text, Mode=OneWay}" Severity="{x:Bind Vm.OutputCheck.Severity, Mode=OneWay}" />

                    <TextBlock Text="В Discord: Настройки пользователя → «Голос и видео»" Style="{StaticResource XHead}" Margin="0,8,0,0" />
                    <TextBlock TextWrapping="Wrap" LineHeight="22">
                        <Run Text="1. Устройство ввода — «CABLE Output (VB-Audio Virtual Cable)»." /><LineBreak />
                        <Run Text="2. Устройство вывода — ваши наушники или колонки (не «CABLE Input»)." /><LineBreak />
                        <Run Text="3. Режим ввода — «Активация по голосу». Выключите «Автоматически определять чувствительность» и сдвиньте ползунок почти до упора влево — иначе тихие звуки обрезаются." /><LineBreak />
                        <Run Text="4. «Профиль ввода» — «Студия». В других профилях Discord включает шумоподавление, эхоподавление и автогромкость, а они принимают музыку и звуки за шум и глушат их." /><LineBreak />
                        <Run Text="5. Нажмите «Проверка микрофона» и запустите любой звук — полоска уровня должна двигаться." />
                    </TextBlock>

                    <TextBlock Text="Ваш голос" Style="{StaticResource XHead}" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource XSub}"
                               Text="Микрофон выбирается здесь, в настройках Xoard: голос и звуки вместе уходят в кабель. В Discord микрофон не выбирайте — только CABLE Output. Шум из голоса убирает и громкость выравнивает сам Xoard (Настройки → «Звук и устройства» → «Голос»), поэтому в «Студии» голос звучит чисто." />

                    <TextBlock Text="В играх" Style="{StaticResource XHead}" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource XSub}"
                               Text="Если в игре есть голосовой чат, выберите в её настройках звука микрофон «CABLE Output»." />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Window>
