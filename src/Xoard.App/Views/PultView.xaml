<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Xoard.App.Views.PultView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Xoard.App.ViewModels"
    xmlns:controls="using:Xoard.App.Controls"
    FontFamily="{StaticResource XFontText}"
    Foreground="{StaticResource XInk}">

    <Grid Padding="24,14,24,20" RowDefinitions="Auto,Auto,*" RowSpacing="14">

        <!-- ═══ Шапка: логотип, название и шутка, поиск, состояние, «Стоп всё», настройки ═══ -->
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="14" Height="52">
            <Image Source="ms-appx:///Assets/Logo.png" Width="40" Height="40" AutomationProperties.AccessibilityView="Raw" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="Xoard" Style="{StaticResource XTitle}" LineHeight="26" />
            </StackPanel>

            <Grid Grid.Column="2" Width="230" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" PlaceholderText="Поиск звуков" AutomationProperties.Name="Поиск звуков" Height="40" Padding="34,9,10,0"
                         CornerRadius="{Binding Control, Source={StaticResource Shape}}" FontSize="14"
                         Text="{x:Bind Vm.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <FontIcon Glyph="&#xE721;" FontSize="15" Foreground="{StaticResource XMuted}" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
            </Grid>

            <Button Grid.Column="3" Style="{StaticResource XQuietButton}" Foreground="{StaticResource XMuted}" Padding="8,0" Height="40"
                    CornerRadius="{Binding Control, Source={StaticResource Shape}}" AutomationProperties.Name="Состояние звука"
                    ToolTipService.ToolTip="Состояние звука, VB-CABLE и Discord">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8" Fill="{x:Bind Vm.StatusDot, Mode=OneWay}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" FontWeight="Normal" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Width="380" Spacing="8">
                            <TextBlock Text="{x:Bind Vm.VbCableText, Mode=OneWay}" TextWrapping="Wrap" />
                            <HyperlinkButton Content="Скачать VB-CABLE" Command="{x:Bind Vm.OpenVbCableSiteCommand}"
                                             Visibility="{x:Bind Vm.VbCableMissing, Mode=OneWay}" Padding="0" />
                            <HyperlinkButton Content="Как настроить Discord" Command="{x:Bind Vm.ShowSetupGuideCommand}" Padding="0" />
                            <ItemsControl ItemsSource="{x:Bind Vm.Issues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:IssueView">
                                        <InfoBar IsOpen="True" IsClosable="False" Margin="0,4,0,0" Title="{x:Bind Title}" Message="{x:Bind Message}" Severity="{x:Bind Severity}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <Button Grid.Column="4" Style="{StaticResource XTonalButton}" Command="{x:Bind Vm.StopAllCommand}" Height="40"
                    CornerRadius="{Binding Control, Source={StaticResource Shape}}" ToolTipService.ToolTip="Остановить все звуки">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                    <TextBlock Text="Стоп всё" />
                </StackPanel>
            </Button>

            <Button Grid.Column="5" Style="{StaticResource XIconButton}" Command="{x:Bind Vm.OpenSettingsCommand}"
                    CornerRadius="{Binding Control, Source={StaticResource Shape}}" AutomationProperties.Name="Настройки" ToolTipService.ToolTip="Настройки">
                <FontIcon Glyph="&#xE713;" FontSize="18" />
            </Button>
        </Grid>

        <!-- ═══ Живая полоса: последние N секунд по дорожкам ═══ -->
        <Border Grid.Row="1" Height="124" Padding="18,12" Background="{StaticResource XSurface}" BorderBrush="{StaticResource XLine}"
                BorderThickness="{Binding CardBorder, Source={StaticResource Shape}}" CornerRadius="{Binding Card, Source={StaticResource Shape}}">
            <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="18">
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{x:Bind Vm.ReplayTitle, Mode=OneWay}" Style="{StaticResource XHead}" />
                    <TextBlock Text="Discord, игра и голос — каждый на своей дорожке" Style="{StaticResource XCap}" FontWeight="Normal" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource XRecording}" VerticalAlignment="Center" Visibility="{x:Bind Vm.ReplayEnabled, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Vm.ReplayStateText, Mode=OneWay}" Style="{StaticResource XCap}" Foreground="{StaticResource XPrimary}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="4" AutomationProperties.Name="Волны последних секунд по дорожкам: Discord, игра, голос">
                    <controls:LiveTracksView Tracks="{x:Bind Vm.LiveTracks}" LabelBrush="{StaticResource XMuted}" Divisions="{x:Bind Vm.ReplayDivisions, Mode=OneWay}" PeakBrush="{StaticResource XWave}" RmsBrush="{StaticResource XPrimary}" LineBrush="{StaticResource XWave}" TickBrush="{StaticResource XLine}" />
                    <Rectangle Width="2" HorizontalAlignment="Right" Fill="{StaticResource XAccent}" Margin="0,-2,0,-2" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*,Auto" Margin="60,0,0,0">
                        <TextBlock FontFamily="{StaticResource XFontMono}" Text="{x:Bind Vm.ReplayTickFar, Mode=OneWay}" Style="{StaticResource XCap}" FontWeight="Normal" />
                        <TextBlock FontFamily="{StaticResource XFontMono}" Grid.Column="1" Text="{x:Bind Vm.ReplayTickMid, Mode=OneWay}" Style="{StaticResource XCap}" FontWeight="Normal" />
                        <TextBlock FontFamily="{StaticResource XFontMono}" Grid.Column="2" Text="{x:Bind Vm.ReplayTickNear, Mode=OneWay}" Style="{StaticResource XCap}" FontWeight="Normal" />
                        <TextBlock Grid.Column="3" Text="сейчас" Style="{StaticResource XCap}" Foreground="{StaticResource XInk}" />
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                    <Button Style="{StaticResource XPrimaryButton}" Command="{x:Bind Vm.SaveReplayCommand}"
                            CornerRadius="{Binding Control, Source={StaticResource Shape}}" AutomationProperties.Name="Сохранить повтор">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE81C;" FontSize="16" />
                            <TextBlock Text="{x:Bind Vm.ReplaySaveShort, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{x:Bind Vm.ReplaySaveHint, Mode=OneWay}" Style="{StaticResource XCap}" FontWeight="Normal" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Звуки слева, запись и громкость справа ═══ -->
        <Grid Grid.Row="2" ColumnDefinitions="*,320" ColumnSpacing="20">
            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8" Height="34">
                    <TextBlock Text="Звуки" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Vm.SoundsCountText, Mode=OneWay}" Style="{StaticResource XSub}" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Style="{StaticResource XQuietButton}" Command="{x:Bind Vm.ToggleModeCommand}" Height="32"
                            CornerRadius="{Binding Control, Source={StaticResource Shape}}" AutomationProperties.Name="Режим повторного нажатия"
                            ToolTipService.ToolTip="Повторное нажатие: наложить звук поверх играющего или начать заново">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="{x:Bind Vm.ModeGlyph, Mode=OneWay}" FontSize="13" />
                            <TextBlock Text="{x:Bind Vm.ModeText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource XTonalButton}" Command="{x:Bind Vm.AddSoundsCommand}" Height="32"
                            CornerRadius="{Binding Control, Source={StaticResource Shape}}" ToolTipService.ToolTip="Добавить mp3, wav, flac… (или перетащите файлы в окно)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                            <TextBlock Text="Добавить" />
                        </StackPanel>
                    </Button>
                </Grid>

                <GridView Grid.Row="1" x:Name="SoundsGrid" ItemsSource="{x:Bind Vm.VisibleSounds}" Padding="0" Margin="0,0,-10,0"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnSoundClick"
                          CanDragItems="{x:Bind Vm.IsSearchEmpty, Mode=OneWay}" CanReorderItems="{x:Bind Vm.IsSearchEmpty, Mode=OneWay}"
                          AllowDrop="True" DragItemsCompleted="OnDragItemsCompleted" SizeChanged="OnGridSizeChanged">
                    <GridView.Resources>
                        <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
                        <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent" />
                    </GridView.Resources>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0,0,10,10" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="220" ItemHeight="114" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SoundItem">
                            <Grid Background="{StaticResource XSurface}" BorderBrush="{StaticResource XLine}"
                                  BorderThickness="{Binding CardBorder, Source={StaticResource Shape}}" CornerRadius="{Binding Card, Source={StaticResource Shape}}"
                                  ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Играть" Command="{x:Bind PlayCommand}">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Только мне (предпрослушать)" Command="{x:Bind PreviewCommand}">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7F6;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Назначить клавишу…" Command="{x:Bind AssignHotkeyCommand}">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE765;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Обрезать…" Command="{x:Bind TrimCommand}">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A8;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Переименовать…" Command="{x:Bind RenameCommand}">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Показать в папке" Command="{x:Bind ShowInFolderCommand}">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Удалить в корзину" Command="{x:Bind DeleteCommand}">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>

                                <!-- Играет: тональная заливка -->
                                <Border Background="{StaticResource XPrimarySoft}" Visibility="{x:Bind IsPlaying, Mode=OneWay}"
                                        CornerRadius="{Binding Card, Source={StaticResource Shape}}" />

                                <Grid Padding="14,12" RowDefinitions="Auto,*,Auto">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="1" Glyph="&#xE71A;" FontSize="13" Foreground="{StaticResource XPrimary}" Visibility="{x:Bind IsPlaying, Mode=OneWay}" />
                                        <ProgressRing Grid.Column="1" Width="14" Height="14" IsActive="{x:Bind IsLoading, Mode=OneWay}" />
                                        <FontIcon Grid.Column="1" Glyph="&#xE7BA;" FontSize="14" Foreground="{StaticResource XAccent}" Visibility="{x:Bind HasError, Mode=OneWay}" />
                                    </Grid>
                                    <controls:WaveView Grid.Row="1" Height="26" VerticalAlignment="Center" Peaks="{x:Bind Wave, Mode=OneWay}" Progress="{x:Bind Progress, Mode=OneWay}"
                                                       WaveBrush="{StaticResource XWave}" PlayedBrush="{StaticResource XPrimary}" />
                                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock FontFamily="{StaticResource XFontMono}" Text="{x:Bind DurationText, Mode=OneWay}" Style="{StaticResource XSub}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Padding="6,1" BorderBrush="{StaticResource XLine}" BorderThickness="1" VerticalAlignment="Center"
                                                CornerRadius="{Binding Chip, Source={StaticResource Shape}}" Visibility="{x:Bind HasHotkey, Mode=OneWay}">
                                            <TextBlock FontFamily="{StaticResource XFontMono}" Text="{x:Bind HotkeyText, Mode=OneWay}" Style="{StaticResource XCap}" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- Пусто / ничего не найдено -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Visibility="{x:Bind Vm.HasNoSounds, Mode=OneWay}">
                    <TextBlock Text="Добавьте первые звуки" Style="{StaticResource XTitle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Перетащите mp3 или wav в окно — или нажмите «Добавить». Можно и сохранить повтор сверху." Style="{StaticResource XSub}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="360" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="Ничего не найдено" Style="{StaticResource XSub}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{x:Bind Vm.HasNoMatches, Mode=OneWay}" />
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <!-- Запись -->
                    <Border Padding="18,16" Background="{StaticResource XSurface}" BorderBrush="{StaticResource XLine}"
                            BorderThickness="{Binding CardBorder, Source={StaticResource Shape}}" CornerRadius="{Binding Card, Source={StaticResource Shape}}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <TextBlock Text="Запись" Style="{StaticResource XHead}" />
                                <TextBlock Text="{x:Bind Vm.RecordHotkeyShort, Mode=OneWay}" Style="{StaticResource XCap}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Пишутся три дорожки: Discord, игра и голос" Style="{StaticResource XCap}" FontWeight="Normal" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Button Style="{StaticResource XButton}" Command="{x:Bind Vm.ToggleRecordingCommand}" Width="56" Height="56" Padding="0" CornerRadius="28"
                                        Background="{StaticResource XAccent}" Foreground="{StaticResource XOnAccent}"
                                        AutomationProperties.Name="Начать или остановить запись" ToolTipService.ToolTip="{x:Bind Vm.RecordButtonText, Mode=OneWay}">
                                    <Grid>
                                        <Ellipse Width="18" Height="18" Fill="{StaticResource XOnAccent}" Visibility="{x:Bind Vm.IsNotRecording, Mode=OneWay}" />
                                        <Rectangle Width="18" Height="18" RadiusX="3" RadiusY="3" Fill="{StaticResource XOnAccent}" Visibility="{x:Bind Vm.IsRecording, Mode=OneWay}" />
                                    </Grid>
                                </Button>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{x:Bind Vm.RecordingTimeText, Mode=OneWay}" FontFamily="{StaticResource XFontMono}" FontSize="30" FontWeight="Bold" LineHeight="32" />
                                    <TextBlock Text="Потом выделите нужный кусок" Style="{StaticResource XSub}" />
                                </StackPanel>
                            </StackPanel>
                            <ProgressBar Maximum="1" Value="{x:Bind Vm.RecordingMeter, Mode=OneWay}" Visibility="{x:Bind Vm.IsRecording, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!-- Громкость -->
                    <Border Padding="18,16" Background="{StaticResource XSurface}" BorderBrush="{StaticResource XLine}"
                            BorderThickness="{Binding CardBorder, Source={StaticResource Shape}}" CornerRadius="{Binding Card, Source={StaticResource Shape}}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Громкость" Style="{StaticResource XHead}" Margin="0,0,0,6" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Мне в наушники" FontSize="14" />
                                <TextBlock FontFamily="{StaticResource XFontMono}" Grid.Column="1" Text="{x:Bind Vm.HeadphonesText, Mode=OneWay}" Style="{StaticResource XSub}" />
                            </Grid>
                            <Slider AutomationProperties.Name="Громкость в наушниках" Minimum="0" Maximum="200" TickFrequency="100" TickPlacement="Outside" StepFrequency="1" IsThumbToolTipEnabled="False"
                                    Value="{x:Bind Vm.HeadphonesLevel, Mode=TwoWay}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Звуки друзьям" FontSize="14" />
                                <TextBlock FontFamily="{StaticResource XFontMono}" Grid.Column="1" Text="{x:Bind Vm.CableText, Mode=OneWay}" Style="{StaticResource XSub}" />
                            </Grid>
                            <Slider AutomationProperties.Name="Громкость звуков для друзей" Minimum="0" Maximum="200" TickFrequency="100" TickPlacement="Outside" StepFrequency="1" IsThumbToolTipEnabled="False"
                                    Value="{x:Bind Vm.CableLevel, Mode=TwoWay}" />
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Text="Мой голос" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock FontFamily="{StaticResource XFontMono}" Grid.Column="1" Text="{x:Bind Vm.MicText, Mode=OneWay}" Style="{StaticResource XSub}" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="2" IsChecked="{x:Bind Vm.MicMuted, Mode=TwoWay}" AutomationProperties.Name="Выключить голос" Padding="6,2" MinHeight="0"
                                              CornerRadius="{Binding Chip, Source={StaticResource Shape}}" ToolTipService.ToolTip="Выключить голос (друзья слышат только звуки)">
                                    <FontIcon Glyph="&#xF781;" FontSize="12" />
                                </ToggleButton>
                            </Grid>
                            <Slider AutomationProperties.Name="Громкость голоса" Minimum="0" Maximum="200" TickFrequency="100" TickPlacement="Outside" StepFrequency="1" IsThumbToolTipEnabled="False"
                                    Value="{x:Bind Vm.MicLevel, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
