<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Xoard.App.Views.ClipEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource XFontText}"
    Foreground="{StaticResource XInk}">

    <Border MaxWidth="940" Margin="24" Padding="22,18" Background="{StaticResource XSurface}" BorderBrush="{StaticResource XLine}" BorderThickness="1"
            CornerRadius="{Binding Sheet, Source={StaticResource Shape}}">
        <StackPanel Spacing="12">
            <!-- Заголовок и название -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="2" VerticalAlignment="Bottom">
                    <TextBlock x:Name="TitleText" Style="{StaticResource XTitle}" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource XSub}" FontFamily="{StaticResource XFontMono}" FontSize="13" />
                </StackPanel>
                <StackPanel x:Name="NamePanel" Grid.Column="1" Width="300" Spacing="4">
                    <TextBlock Text="Название" Style="{StaticResource XCap}" />
                    <TextBox x:Name="NameBox" AutomationProperties.Name="Название звука" Height="36" CornerRadius="{Binding Control, Source={StaticResource Shape}}" />
                </StackPanel>
            </Grid>

            <!-- Волна: тяните края выделения или выделите кусок мышкой -->
            <Grid x:Name="WaveArea" Height="180" Background="{StaticResource XBg}" BorderBrush="{StaticResource XLine}" BorderThickness="1"
                  CornerRadius="{Binding Control, Source={StaticResource Shape}}" SizeChanged="OnWaveSizeChanged">
                <Canvas x:Name="WaveCanvas" Background="Transparent" PointerPressed="OnWavePressed" PointerMoved="OnWaveMoved"
                        PointerReleased="OnWaveReleased" PointerCaptureLost="OnWaveCaptureLost"
                        AutomationProperties.Name="Волна клипа: выделите кусок мышкой" />
            </Grid>
            <Canvas x:Name="Ruler" Height="16" Margin="1,-6,1,0" />

            <!-- Отсчёты -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="SelectionText" FontFamily="{StaticResource XFontMono}" FontSize="13" />
                <TextBlock x:Name="LengthText" Grid.Column="1" FontFamily="{StaticResource XFontMono}" FontSize="13" Foreground="{StaticResource XMuted}" />
            </Grid>

            <!-- Действия -->
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                <Button Style="{StaticResource XTonalButton}" Click="OnPreview" Height="40" CornerRadius="{Binding Control, Source={StaticResource Shape}}"
                        ToolTipService.ToolTip="Прослушать выделенное в наушниках (друзья не слышат)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="13" />
                        <TextBlock Text="Прослушать" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource XQuietButton}" Click="OnStopPreview" Height="40" Width="40" Padding="0"
                        CornerRadius="{Binding Control, Source={StaticResource Shape}}" AutomationProperties.Name="Остановить прослушивание" ToolTipService.ToolTip="Остановить">
                    <FontIcon Glyph="&#xE71A;" FontSize="13" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource XQuietButton}" Click="OnResetSelection" Height="40" Content="Сбросить выделение"
                        CornerRadius="{Binding Control, Source={StaticResource Shape}}" ToolTipService.ToolTip="Выделить весь клип" />

                <Button x:Name="DiscardButton" Grid.Column="4" Style="{StaticResource XQuietButton}" Click="OnDiscard" Height="40"
                        Foreground="{StaticResource XRecording}" CornerRadius="{Binding Control, Source={StaticResource Shape}}" Content="Выбросить" />
                <Button x:Name="SaveWholeButton" Grid.Column="5" Style="{StaticResource XTonalButton}" Click="OnSaveWhole" Height="40"
                        CornerRadius="{Binding Control, Source={StaticResource Shape}}" Content="Сохранить целиком" />
                <Button x:Name="SaveButton" Grid.Column="6" Style="{StaticResource XPrimaryButton}" Click="OnSave" Height="40" FontSize="14"
                        CornerRadius="{Binding Control, Source={StaticResource Shape}}" Content="Сохранить выделенное" />
            </Grid>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource XRecording}" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="HintText" Style="{StaticResource XCap}" FontWeight="Normal" TextWrapping="Wrap"
                       Text="Тяните края выделения или выделите мышкой нужный кусок. Прослушивание слышите только вы." />
        </StackPanel>
    </Border>
</UserControl>
