<Project Sdk="Microsoft.NET.Sdk">

  <!-- Юнит-тесты ядра (xUnit v3 на Microsoft Testing Platform: dotnet test или dotnet run) -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Soundboard.Core.Tests</RootNamespace>
    <!-- CA1707: подчёркивания в именах тестов — общепринятый стиль -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Soundboard.Core\Soundboard.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
