<Project Sdk="Microsoft.NET.Sdk">

  <!-- Юнит-тесты ядра (xUnit v3 на Microsoft Testing Platform: dotnet test или dotnet run) -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Xoard.Core.Tests</RootNamespace>
    <!-- CA1707: подчёркивания в именах тестов — общепринятый стиль -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- MCP-клиент: проверяем собранный Xoard.Mcp.exe так же, как его вызывает Claude Desktop -->
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Xoard.Core\Xoard.Core.csproj" />
    <!-- Только порядок сборки: тест запускает готовый exe -->
    <ProjectReference Include="..\..\src\Xoard.Mcp\Xoard.Mcp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
